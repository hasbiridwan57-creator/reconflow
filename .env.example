# Contoh environment ReconFlow (PostgreSQL — Neon).
# Salin ke .env (LOKAL, JANGAN di-commit) dan isi kredensial asli.

# Runtime (Vercel/Neon pooled endpoint):
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Catatan: untuk `prisma db push` / migrasi, gunakan Neon DIRECT endpoint.
